# Copy this file to .env and fill in real values. Never commit .env.
# This project reads config from environment variables only — no secrets
# are hard-coded. Sections below: job discovery (Adzuna), optional
# direct-watch (Greenhouse/Lever), core engine tuning, and Gmail delivery.

# --- Job discovery (Adzuna) --------------------------------------------------
# PRIMARY discovery mechanism: searches by role/keyword, not by company, so
# you never have to name companies in advance. Free tier - see README "Job
# discovery via Adzuna" for signup instructions (developer.adzuna.com).
# Without these two set, discovery is simply disabled (logged, not a
# crash) and only direct-watch sources below (if any) are used.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: comma-separated search terms. Leave BLANK to automatically
# search your candidate profile's target roles (see profile.py) - this is
# the recommended default and needs no manual list.
ADZUNA_SEARCH_TERMS=

# Only consider Adzuna postings created within this many days (default: 4)
ADZUNA_MAX_DAYS_OLD=4

# Results per Adzuna search term/query (default: 25 - kept modest to stay
# well within the free-tier rate limits; see README for the quota math)
ADZUNA_RESULTS_PER_PAGE=25

# Best-effort Greenhouse/Lever enrichment of Adzuna results (cleaner direct
# URL + full description when a confident match is found). true/false (default: true)
ADZUNA_ENRICH=true

# Cap on distinct companies enriched per run, to avoid excessive lookups
# against Greenhouse/Lever for companies that likely aren't there (default: 20)
ADZUNA_ENRICHMENT_MAX_COMPANIES=20

# --- Direct-watch (Greenhouse/Lever) — OPTIONAL, not required for discovery -
# Comma-separated Greenhouse board tokens (the slug in
# https://boards.greenhouse.io/<token>). Leave BLANK to use the boards
# configured in config/boards.json instead (recommended if you want to
# always watch specific companies in addition to Adzuna discovery).
# Setting this env var overrides that file.
GREENHOUSE_BOARDS=

# Comma-separated Lever company slugs (the slug in
# https://jobs.lever.co/<slug>). Same override behavior as above.
LEVER_COMPANIES=

# Path to the editable board/company config file (default: config/boards.json)
BOARDS_CONFIG_PATH=config/boards.json

# --- Core engine tuning ------------------------------------------------------
# Only keep postings updated within this many days (default: 4)
RECENCY_DAYS=4

# Hard-exclude postings that explicitly require at least this many years (default: 6)
HARD_EXCLUDE_EXPERIENCE_YEARS=6

# Your actual years of experience, used to score fit (default: 4)
CANDIDATE_EXPERIENCE_YEARS=4

# How many ranked jobs the CLI prints by default (default: 15)
RESULTS_LIMIT=15

# Where JsonFileSeenJobStore persists stable job ids between runs (default: data/seen_jobs.json)
SEEN_STORE_PATH=data/seen_jobs.json

# Python logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# --- Gmail email delivery ----------------------------------------------------
# See README "Gmail API setup" for how to obtain these. All four are
# secrets - never commit real values, and store them as GitHub Actions
# repository secrets (not repo variables) once you get to that stage.

# OAuth2 client credentials from a Google Cloud "Desktop app" OAuth client.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Long-lived refresh token obtained once via scripts/get_gmail_refresh_token.py
GMAIL_REFRESH_TOKEN=

# Override only if you have a reason to use a non-default OAuth token endpoint.
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token

# Where the job-report emails get sent. Required to send anything - never
# hard-coded in source.
JOBSEARCH_RECIPIENT_EMAIL=

# Optional: override the "From" header (must be a verified alias on the
# authenticated Gmail account, otherwise Gmail ignores it). Leave blank to
# just use the authenticated account's own address.
JOBSEARCH_SENDER_EMAIL=

# Optional: prefix added to every email subject line, e.g. "[JobBot] "
JOBSEARCH_EMAIL_SUBJECT_PREFIX=


